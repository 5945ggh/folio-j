{
  "sharedCss": ".card {\n  color: #25303b;\n  background: #fff;\n  font: 19px/1.65 system-ui, sans-serif;\n  text-align: left;\n}\n.fj { max-width: 36em; margin: 1.25em auto; padding: 0 1em; }\n.fj p { margin: .55em 0; }\n.fj-word { font: 600 34px/1.5 \"Hiragino Mincho ProN\", \"Yu Mincho\", serif; }\n.fj-jp { font-family: \"Hiragino Mincho ProN\", \"Yu Mincho\", serif; }\n.fj-word-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15em .65em; }\n.fj-word-meta:empty, .fj-example:empty { display: none; }\n.fj-reading, .fj-part-of-speech { font-size: 15px; }\n.fj-reading, .fj-source { color: #586578; }\n.fj-part-of-speech { color: #32675d; }\n.fj p.fj-meaning { margin: 12px 0 0; }\n.fj-example { margin-top: 16px; }\n.fj-example:first-child { margin-top: 0; }\n.fj .fj-example p { margin: 0; }\n.fj .fj-example .fj-jp + .fj-sentence-meaning { margin-top: 4px; }\n.fj-sentence-meaning { font-size: 16px; color: #657284; }\n.fj-example + .fj-reading { margin-top: .55em; }\n.fj-source { margin-top: 1.25em; font-size: .8em; }\n.fj-source::before { content: \"\"; display: block; width: 1.8em; border-top: 1px solid currentColor; margin-bottom: .45em; }\n.fj-media img, .fj-media video { max-width: 100%; height: auto; }\n.fj .sentence-focus { color: #414b9b; font-weight: 700; }\n.nightMode.card, .night_mode.card { color: #e6eaf0; background: #22272e; }\n.nightMode .fj-source, .nightMode .fj-reading, .night_mode .fj-source, .night_mode .fj-reading { color: #b7c0cf; }\n.nightMode .fj-part-of-speech, .night_mode .fj-part-of-speech { color: #a9d6c8; }\n.nightMode .fj-sentence-meaning, .night_mode .fj-sentence-meaning { color: #aeb9ca; }\n.nightMode .fj .sentence-focus, .night_mode .fj .sentence-focus { color: #b9c3ff; }\n.fj-question .fj-jp rt { display: none; }\n.fj.fj-question .fj-jp .sentence-focus { color: inherit; font-weight: inherit; }",
