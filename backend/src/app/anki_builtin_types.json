          "front": "<!-- folio-j.vocabulary-recall@1 -->\n{{#Word}}<main class=\"fj fj-question\"><div class=\"fj-word\" lang=\"ja\">{{Word}}</div>{{#Sentence}}<p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p>{{/Sentence}}</main>{{/Word}}",
          "back": "<!-- folio-j.vocabulary-recall@1 -->\n<main class=\"fj\"><div class=\"fj-word\" lang=\"ja\">{{Word}}</div>{{#Reading}}<div class=\"fj-reading\" lang=\"ja\">{{Reading}}</div>{{/Reading}}<p>{{Meaning}}</p>{{#Sentence}}<p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p>{{/Sentence}}{{#SentenceAudio}}<div>{{SentenceAudio}}</div>{{/SentenceAudio}}{{#Picture}}<div class=\"fj-media\">{{Picture}}</div>{{/Picture}}{{#Video}}<div class=\"fj-media\">{{Video}}</div>{{/Video}}{{#SourceMetadata}}<footer class=\"fj-source\">{{SourceMetadata}}</footer>{{/SourceMetadata}}</main>"
        }
