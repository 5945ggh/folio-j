{
  "format": "Folio-J 导出设计样本",
  "sharedCss": ".card {\n  color: #25303b;\n  background: #fff;\n  font: 18px/1.65 system-ui, sans-serif;\n  text-align: left;\n}\n.fj { max-width: 36em; margin: 1.25em auto; padding: 0 1em; }\n.fj-word { font: 600 1.8em/1.5 \"Hiragino Mincho ProN\", \"Yu Mincho\", serif; }\n.fj-jp { margin: .55em 0; font-family: \"Hiragino Mincho ProN\", \"Yu Mincho\", serif; }\n.fj-reading, .fj-source { font-size: .8em; color: #586578; }\n.fj-source { margin-top: 1.25em; }\n.fj-source::before { content: \"\"; display: block; width: 1.8em; border-top: 1px solid currentColor; margin-bottom: .45em; }\n.fj-media img, .fj-media video { max-width: 100%; height: auto; }\n.nightMode.card, .night_mode.card { color: #e6eaf0; background: #22272e; }\n.nightMode .fj-source, .nightMode .fj-reading, .night_mode .fj-source, .night_mode .fj-reading { color: #b7c0cf; }\n.fj-question .fj-jp rt { display: none; }",
  "noteTypes": [
    {
      "id": "folio-j.vocabulary-recall",
      "version": 1,
      "name": "Folio-J 词汇",
      "fields": [
        "Word",
        "Meaning",
        "Reading",
        "Sentence",
        "SentenceAudio",
        "Picture",
        "Video",
        "SourceMetadata"
      ],
      "cardTemplates": [
        {
          "name": "词义回忆",
          "front": "<!-- folio-j.vocabulary-recall@1 -->\n{{#Word}}<main class=\"fj fj-question\"><div class=\"fj-word\" lang=\"ja\">{{Word}}</div>{{#Sentence}}<p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p>{{/Sentence}}</main>{{/Word}}",
          "back": "<!-- folio-j.vocabulary-recall@1 -->\n<main class=\"fj\"><div class=\"fj-word\" lang=\"ja\">{{Word}}</div>{{#Reading}}<div class=\"fj-reading\" lang=\"ja\">{{Reading}}</div>{{/Reading}}<p>{{Meaning}}</p>{{#Sentence}}<p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p>{{/Sentence}}{{#SentenceAudio}}<div>{{SentenceAudio}}</div>{{/SentenceAudio}}{{#Picture}}<div class=\"fj-media\">{{Picture}}</div>{{/Picture}}{{#Video}}<div class=\"fj-media\">{{Video}}</div>{{/Video}}{{#SourceMetadata}}<footer class=\"fj-source\">{{SourceMetadata}}</footer>{{/SourceMetadata}}</main>"
        }
      ]
    },
    {
      "id": "folio-j.sentence-reading",
      "version": 1,
      "name": "Folio-J 例句",
      "fields": [
        "Sentence",
        "Explanation",
        "Target",
        "SentenceAudio",
        "Picture",
        "Video",
        "SourceMetadata"
      ],
      "cardTemplates": [
        {
          "name": "例句理解",
          "front": "<!-- folio-j.sentence-reading@1 -->\n{{#Sentence}}<main class=\"fj fj-question\"><p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p></main>{{/Sentence}}",
          "back": "<!-- folio-j.sentence-reading@1 -->\n<main class=\"fj\"><p class=\"fj-jp\" lang=\"ja\">{{Sentence}}</p><p>{{Explanation}}</p>{{#Target}}<div class=\"fj-reading\" lang=\"ja\">{{Target}}</div>{{/Target}}{{#SentenceAudio}}<div>{{SentenceAudio}}</div>{{/SentenceAudio}}{{#Picture}}<div class=\"fj-media\">{{Picture}}</div>{{/Picture}}{{#Video}}<div class=\"fj-media\">{{Video}}</div>{{/Video}}{{#SourceMetadata}}<footer class=\"fj-source\">{{SourceMetadata}}</footer>{{/SourceMetadata}}</main>"
        }
      ]
    }
  ],
